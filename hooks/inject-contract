#!/bin/bash

# shellcheck source=include.sh
. "${HOME}/.config/agents/hooks/include.sh"

CONTRACT_ROOT="${HOME}/.config/agents/contracts/"

if [ -n "${1:-}" ]; then
    TARGET="${ROOT}/${1}"
    mkdir -p "$(dirname "${TARGET}")"
    if [ -e "${TARGET}" ] && [ ! -f "${TARGET}" ]; then
        echo "FATAL: Not a file: ${TARGET}" >/dev/stderr
        exit 2
    elif [ -e "${TARGET}" ]; then
        rm -f "${TARGET}"
    fi
else
    TARGET="/dev/stdout"
fi

BYTE_COUNT=0
_output() {
    local CONTENT
    CONTENT="$(cat -)"
    BYTE_COUNT=$((BYTE_COUNT + $(echo -n "${CONTENT}" | wc -c)))
    echo "${CONTENT}" >>"${TARGET}"
}

_output_contract() {
    local CONTRACT_NAME=$1
    if [[ "${CONTRACT_NAME}" != "/"* ]]; then
        local CONTRACT_PATH="${CONTRACT_ROOT}/${CONTRACT_NAME}.md"
    else
        local CONTRACT_PATH="${CONTRACT_NAME}"
    fi

    if [ ! -f "${CONTRACT_PATH}" ]; then
        _fatal "Contract file not found: ${CONTRACT_PATH}"
    fi

    _output < <(cat "${CONTRACT_PATH}" | sed 's/^#/##/')
    _output < <(echo)

    _info "Added contract: ${CONTRACT_NAME}"
}

_output < <(echo '# AGENTS.md')
_output < <(echo)
_output_contract "general"

if [ -d "${ROOT}/.agents/contracts" ]; then
    if [ -f "${ROOT}/.agents/contracts/common" ]; then
        while IFS= read -r CONTRACT_NAME; do
            _output_contract "${CONTRACT_NAME}"
        done <"${ROOT}/.agents/contracts/common"
    fi
    find "${ROOT}/.agents/contracts" -type f -name "*.md" | while read -r CONTRACT_FILE; do
        _output_contract "${CONTRACT_FILE}"
    done
fi

_info "Total contract byte count: ${BYTE_COUNT}"
