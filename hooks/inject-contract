#!/usr/bin/env python3
"""Generate AGENTS.md from global and project contracts.

Global contracts live in ~/.config/agents/contracts as NN-name.md or
NNx-name.md (x a lowercase letter) and are referenced by bare name from
.agents/contracts/common files. They are gathered from every directory between
/ and the project root, deduplicated, sorted by filename (i.e. by the prefix)
and emitted first. Project contracts
(.agents/contracts/**/*.md) follow, outermost directory first.

Usage: <hook payload on stdin> | agents_md.py [TARGET]
TARGET is relative to the project root; without it, output goes to stdout.
"""

from __future__ import annotations

import json
import os
import re
import sys
from datetime import datetime
from pathlib import Path
from typing import NoReturn

CONTRACT_ROOT = Path.home() / ".config/agents/contracts"
ALWAYS_INCLUDED = ["general", "writing"]
NUMBERED = re.compile(r"[0-9]{2}[a-z]?-(?P<name>.+)\.md")
FENCE = re.compile(r" {0,3}(`{3,}|~{3,})")
HOOK_NAME = Path(sys.argv[0]).name


# --- include.sh ---------------------------------------------------------------

def log(level: str, msg: str) -> None:
    ts = datetime.now().astimezone().isoformat(timespec="seconds")
    print(f"[{ts}] [{level}] {msg}", file=sys.stderr)


def info(msg: str) -> None:
    log("INFO", msg)


def fatal(msg: str, code: int = 1) -> NoReturn:
    log("FATAL", msg)
    sys.exit(code)


def init_hook() -> Path:
    """Read the hook payload, send stderr to the session log, cd into the project."""
    try:
        payload = json.load(sys.stdin)
        cwd, session_id = str(payload["cwd"]), str(payload["session_id"])
    except (ValueError, KeyError, TypeError) as e:
        fatal(f"Invalid hook payload: {e!r}")

    # cwd is absolute; strip the leading slash or pathlib would discard the prefix
    log_dir = Path("/tmp/agents", session_id, cwd.lstrip("/"))
    try:
        log_dir.mkdir(parents=True, exist_ok=True)
        fd = os.open(log_dir / f"{HOOK_NAME}.log", os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
    except OSError as e:
        fatal(f"Failed to create log file in {log_dir}: {e}")
    sys.stderr.flush()
    os.dup2(fd, 2)  # same as `exec 2>>`: tracebacks land in the log too
    os.close(fd)

    try:
        os.chdir(cwd)
    except OSError as e:
        fatal(f"Failed to change directory to {cwd}: {e}")
    info(f"Changed to directory: {cwd}")
    return Path(cwd).resolve()


# --- contracts ----------------------------------------------------------------

def index_global_contracts() -> dict[str, list[Path]]:
    """Map bare name -> numbered contract files in CONTRACT_ROOT."""
    if not CONTRACT_ROOT.is_dir():
        fatal(f"Contract directory not found: {CONTRACT_ROOT}")
    index: dict[str, list[Path]] = {}
    for path in CONTRACT_ROOT.iterdir():
        m = NUMBERED.fullmatch(path.name)
        if m and path.is_file():
            index.setdefault(m["name"], []).append(path)
    return index


def resolve_global(name: str, index: dict[str, list[Path]], source: str) -> Path:
    if name.startswith("/"):  # absolute paths are used as-is
        matches = [Path(name)] if Path(name).is_file() else []
    else:
        matches = index.get(name, [])
    if not matches:
        fatal(f"Contract not found: {name} (referenced in {source})")
    if len(matches) > 1:
        fatal(f"Ambiguous contract {name!r}: {', '.join(sorted(p.name for p in matches))}")
    return matches[0]


def read_common(path: Path) -> list[str]:
    lines = (line.strip() for line in path.read_text(encoding="utf-8").splitlines())
    return [line for line in lines if line and not line.startswith("#")]


def demote_headings(text: str) -> str:
    """Prefix lines starting with '#' with another '#', skipping fenced code blocks."""
    out, fence = [], None
    for line in text.splitlines(keepends=True):
        m = FENCE.match(line)
        if fence is None:
            if m:
                fence = m[1]
            elif line.startswith("#"):
                line = "#" + line
        elif m and m[1].startswith(fence) and not line[m.end():].strip():
            fence = None
        out.append(line)
    return "".join(out)


def main() -> None:
    root = init_hook()
    index = index_global_contracts()

    global_paths: dict[Path, Path] = {}  # resolved path -> path as found
    project_paths: list[Path] = []

    def add_global(name: str, source: str) -> None:
        path = resolve_global(name, index, source)
        global_paths.setdefault(path.resolve(), path)

    for name in ALWAYS_INCLUDED:
        add_global(name, "ALWAYS_INCLUDED")

    for node in [*reversed(root.parents), root]:  # outermost first
        contracts = node / ".agents" / "contracts"
        if not contracts.is_dir():
            continue
        info(f"Processing config in {node}")
        common = contracts / "common"
        if common.is_file():
            for name in read_common(common):
                add_global(name, str(common))
        project_paths += sorted((p for p in contracts.rglob("*.md") if p.is_file()), key=str)

    # Globals sort by filename (NN prefix); project contracts keep tree order.
    ordered = sorted(global_paths.values(), key=lambda p: (p.name, str(p)))
    seen = set(global_paths)
    for path in project_paths:
        if (key := path.resolve()) not in seen:
            seen.add(key)
            ordered.append(path)

    sections = ["# AGENTS.md"]
    for path in ordered:
        sections.append(demote_headings(path.read_text(encoding="utf-8")).rstrip("\n"))
        info(f"Added contract: {path}")
    text = "\n\n".join(sections) + "\n"

    if len(sys.argv) > 1:
        target = root / sys.argv[1]  # an absolute argument replaces root
        target.parent.mkdir(parents=True, exist_ok=True)
        if target.exists() and not target.is_file():
            fatal(f"Not a file: {target}", code=2)
        target.unlink(missing_ok=True)  # replace symlinks rather than write through them
        target.write_text(text, encoding="utf-8")
        info(f"Wrote {target}")
    else:
        sys.stdout.write(text)

    info(f"Total contract byte count: {len(text.encode())}")


if __name__ == "__main__":
    main()
